def bubbles(cr, st, slots, n, wrong_n, active=True, r=24):
    """One bubble at the start. Each key fills one and shows the next empty one. slots gives the centre of bubble i.
    Ready for a key: the empty bubble's ring breathes, bright then soft, once a second.
    Not this row's turn, or being checked: the ring is dull and still; checked ones turn lilac.
    Wrong: they all empty to dull rings and shake from side to side, then one bubble is left."""
    now = time.time(); wrong = st.wrong_until > now
    if wrong: n = wrong_n
    count = n if wrong else n + 1
    dx = 12 * math.sin((st.wrong_until - now) * 42) if wrong else 0
    lw = 4 if r > 18 else 3
    for i in range(count):
        cx, cy = slots(i, count)
        cr.arc(cx + dx, cy, r, 0, 6.2832)
        if wrong:
            cr.set_source_rgb(*rgb(INK)); cr.fill_preserve(); cr.set_source_rgb(*rgb(DUSK)); cr.set_line_width(lw)
        elif i < n:
            cr.set_source_rgb(*rgb(ACC if st.checking else SUN)); cr.fill_preserve(); cr.set_source_rgb(*rgb(INK)); cr.set_line_width(lw)
        else:
            cr.set_source_rgb(*rgb(INK)); cr.fill_preserve()
            if st.checking or not active: cr.set_source_rgba(*rgb(DUSK), 0.6); cr.set_line_width(lw - 1)
            elif int(now) % 2 == 0: cr.set_source_rgb(*rgb(ACC)); cr.set_line_width(lw + 1)
            else: cr.set_source_rgba(*rgb(ACC), 0.5); cr.set_line_width(lw - 1)
        cr.stroke()


def centred(cx, y, per, gap, dy):
    """Places for bubbles centred on cx however many there are: per to a line, then the next line."""
    def slot(i, n):
        row = i // per; inrow = min(per, n - row * per)
        return cx - (inrow - 1) * gap / 2 + (i % per) * gap, y + row * dy
    return slot


def take_key(st, name, u):
    """One key for the two rows: the name first (small bubbles), then the password. True when it is time to check."""
    if name in ('Return', 'KP_Enter', 'Tab'):
        if st.stage == 0:
            if st.user: st.stage = 1
        elif st.typed and name != 'Tab': return True
    elif name == 'BackSpace':
        if st.stage == 1 and not st.typed: st.stage = 0
        elif st.stage == 1: st.typed = st.typed[:-1]
        else: st.user = st.user[:-1]
    elif name == 'Escape': st.user = st.typed = ''; st.stage = 0
    elif u >= 32 and u != 127:                     # 127 is the Delete key: no invisible character
        if st.stage == 0 and len(st.user) < 64: st.user += chr(u)
        elif st.stage == 1 and len(st.typed) < 256: st.typed += chr(u)
    return False


def draw_login(cr, st, cells, turtle):
    """The login: the square in the middle. The name lies over the pattern and behind the turtle, and starts
    outside the square on the left. The bubbles lie over the turtle, lower right, and run out of the square."""

    # three to a row inside the square, then three more beyond its right edge, then the next line
    # the name: small bubbles, a line above. The password: large ones, as before.
    bubbles(cr, st, lambda i, _n: (855 + (i % 12) * 40, 646 + (i // 12) * 36), len(st.user), st.wrong_u, st.stage == 0, 13)
    bubbles(cr, st, lambda i, _n: (863 + (i % 6) * 76, 716 + (i // 6) * 64), len(st.typed), st.wrong_n, st.stage == 1)



class _Msg(ctypes.Structure): _fields_ = [('style', ctypes.c_int), ('msg', ctypes.c_char_p)]
class _Resp(ctypes.Structure): _fields_ = [('resp', ctypes.c_void_p), ('code', ctypes.c_int)]
_CONV = ctypes.CFUNCTYPE(ctypes.c_int, ctypes.c_int, ctypes.POINTER(ctypes.POINTER(_Msg)),
                         ctypes.POINTER(ctypes.POINTER(_Resp)), ctypes.c_void_p)
class _Conv(ctypes.Structure): _fields_ = [('conv', _CONV), ('data', ctypes.c_void_p)]


def pam():
    """The system's own password check (the library the login uses), or None when it cannot be loaded."""
    try:
        lp = ctypes.CDLL(ctypes.util.find_library('pam') or 'libpam.so.0')
        lc = ctypes.CDLL(ctypes.util.find_library('c') or 'libc.so.6')
        lc.calloc.restype = ctypes.c_void_p; lc.calloc.argtypes = [ctypes.c_size_t, ctypes.c_size_t]
        lc.strdup.restype = ctypes.c_void_p; lc.strdup.argtypes = [ctypes.c_char_p]
        lp.pam_start.argtypes = [ctypes.c_char_p, ctypes.c_char_p, ctypes.POINTER(_Conv), ctypes.POINTER(ctypes.c_void_p)]
        lp.pam_authenticate.argtypes = [ctypes.c_void_p, ctypes.c_int]; lp.pam_end.argtypes = [ctypes.c_void_p, ctypes.c_int]
        lp.pam_acct_mgmt.argtypes = [ctypes.c_void_p, ctypes.c_int]
        return lp, lc
    except OSError: return None


def password_ok(word, service='swaylock'):
    """True when word is this user's password. The system answers; the word is not written anywhere (Python cannot wipe it from memory)."""
    libs = pam()
    if not libs: return False
    lp, lc = libs; secret = word.encode()

    @_CONV
    def conv(n, msgs, resp, _data):
        addr = lc.calloc(n, ctypes.sizeof(_Resp))
        if not addr: return 5
        resp[0] = ctypes.cast(addr, ctypes.POINTER(_Resp))
        for i in range(n):
            if msgs[i].contents.style == 1: resp[0][i].resp = lc.strdup(secret)      # 1: a hidden prompt
        return 0

    h = ctypes.c_void_p(); c = _Conv(conv, None)
    if lp.pam_start(service.encode(), pwd.getpwuid(os.getuid()).pw_name.encode(), ctypes.byref(c), ctypes.byref(h)) != 0: return False
    r = lp.pam_authenticate(h, 0)
    if r == 0: r = lp.pam_acct_mgmt(h, 0)            # an expired or locked account does not unlock
    lp.pam_end(h, r)
    return r == 0


def rgb(h): return tuple(int(h[i:i + 2], 16) / 255 for i in (1, 3, 5))


def text(cr, x, y, s, size, col, fam=MONO, weight=400, anchor='start', spacing=0):
    lay = PangoCairo.create_layout(cr)
    fd = Pango.FontDescription(); fd.set_family(fam); fd.set_absolute_size(size * Pango.SCALE)
    fd.set_weight(Pango.Weight(weight)); lay.set_font_description(fd)
    if spacing:
        al = Pango.AttrList(); al.insert(Pango.attr_letter_spacing_new(int(spacing * Pango.SCALE))); lay.set_attributes(al)
    lay.set_text(s, -1)
    w = lay.get_size()[0] / Pango.SCALE - spacing
    if anchor == 'end': x -= w
    elif anchor == 'middle': x -= w / 2
    cr.set_source_rgb(*rgb(col)); cr.move_to(x, y - lay.get_baseline() / Pango.SCALE)
    PangoCairo.show_layout(cr, lay)
    return w


def wordmark(cr, x, y, size, anchor='start'):
    """The word CARETTA, the same everywhere: heavy letters, lilac, with an ink outline. Returns its width."""
    lay = PangoCairo.create_layout(cr); fd = Pango.FontDescription(); fd.set_family(MONO)
    fd.set_absolute_size(size * Pango.SCALE); fd.set_weight(Pango.Weight(700)); lay.set_font_description(fd)
    lay.set_text('CARETTA', -1); w = lay.get_size()[0] / Pango.SCALE
    if anchor == 'middle': x -= w / 2
    cr.move_to(x, y - lay.get_baseline() / Pango.SCALE); PangoCairo.layout_path(cr, lay)
    cr.set_source_rgb(*rgb(INK)); cr.set_line_width(max(2, size * 0.093)); cr.set_line_join(cairo.LINE_JOIN_ROUND)
    cr.stroke_preserve(); cr.set_source_rgb(*rgb(ACC)); cr.fill()
    return w


def rect(cr, x, y, w, h, fill=None, line=None, lw=3, r=0):
    if r:
        cr.new_sub_path()
        for cx, cy, a in ((x + w - r, y + r, -1), (x + w - r, y + h - r, 0), (x + r, y + h - r, 1), (x + r, y + r, 2)):
            cr.arc(cx, cy, r, a * math.pi / 2, (a + 1) * math.pi / 2)
        cr.close_path()
    else: cr.rectangle(x, y, w, h)
    if fill:
        cr.set_source_rgb(*rgb(fill))
        cr.fill_preserve() if line else cr.fill()
    if line: cr.set_source_rgb(*rgb(line)); cr.set_line_width(lw); cr.stroke()


def pill(cr, x, y, w, label, fill=LEAF, ink=INK, h=28, size=14, line=None, spacing=1.4):
    rect(cr, x, y, w, h, fill, line, 2.6, h / 2)
    text(cr, x + w / 2, y + h / 2 + size * 0.36, label, size, ink, MONO, 600, 'middle', spacing)


def panel(cr, x, y, w, h): rect(cr, x, y, w, h, INK, INK, 3)


class State:
    def __init__(self):
        self.msg = ''; self.off_until = 0.0; self.off_kind = 'off'
        self.resting = False; self.last_key = time.time()
        self.mouse = None; self.zones = []; self.scroll = 0; self.info = {}; self._wifi = (0, None)
        self.locked = False; self.typed = ''; self.checking = False; self.wrong_until = 0.0; self.wrong_n = 0
        self.user = ''; self.stage = 0; self.wrong_u = 0     # the name row comes first, then the password row
        self.hist = []; self.load = 0.0; self.procs = []; self.agents = 0; self.agent_mem = 0
        self._cpu = None; self._pt = {}; self._t = None
        self.sample()

    def sample(self):
        now = time.monotonic()
        with open('/proc/stat') as f: v = [int(x) for x in f.readline().split()[1:9]]
        total, idle, system = sum(v), v[3] + v[4], v[2] + v[5] + v[6]
        if self._cpu and total > self._cpu[0]:
            d = total - self._cpu[0]
            self.load = 1 - (idle - self._cpu[1]) / d
            self.hist = (self.hist + [(self.load, (system - self._cpu[2]) / d)])[-40:]
        self._cpu = (total, idle, system)
        dt = (now - self._t) if self._t else 0
        seen, rows, agents, amem = {}, [], 0, 0
        for pid in os.listdir('/proc'):
            if not pid.isdigit(): continue
            try:
                with open(f'/proc/{pid}/stat') as f: s = f.read()
            except OSError: continue
            name = s[s.index('(') + 1:s.rindex(')')]; r = s[s.rindex(')') + 2:].split()
            ticks, rss = int(r[11]) + int(r[12]), int(r[21]) * PAGE
            seen[pid] = ticks
            if rss == 0: continue
            if name == AGENT_PROGRAM: agents += 1; amem += rss
            pct = 100 * (ticks - self._pt[pid]) / (dt * HZ * NCPU) if dt > 0 and pid in self._pt else 0.0
            rows.append((name, rss, pct))
        self._pt = seen; self._t = now; self.agents = agents; self.agent_mem = amem
        self.procs = sorted(rows, key=lambda p: (-round(p[2], 1), -p[1]))[:12]
        self.scroll = max(0, min(self.scroll, len(self.procs) - 4))
        self.info = self._info()

    def _info(self):
        """The small things behind the icons. Each is read from the system; what cannot be read is left out."""
        def read(path):
            try:
                with open(path) as f: return f.read().strip()
            except OSError: return None
        i = {}
        for b in glob.glob('/sys/class/power_supply/BAT*'):
            c = read(b + '/capacity')
            if c: i['battery'] = (int(c), (read(b + '/status') or '').lower()); break
        for line in (read('/proc/net/wireless') or '').splitlines()[2:]:
            f = line.split(); q = int(float(f[2].rstrip('.'))); i['wifi'] = (round(q / 70 * 100), f"on {f[0].rstrip(':')}"); break
        if 'wifi' not in i:                        # some drivers do not fill that file: ask the network manager, every 10 s
            if time.time() - self._wifi[0] > 10:
                try:
                    out = subprocess.run(['nmcli', '-t', '-f', 'IN-USE,SIGNAL', 'dev', 'wifi', 'list', '--rescan', 'no'],
                                         capture_output=True, text=True, timeout=2).stdout
                    hit = [l.split(':')[1] for l in out.splitlines() if l.startswith('*:')]
                    self._wifi = (time.time(), int(hit[0]) if hit else None)
                except (OSError, ValueError, IndexError, subprocess.SubprocessError): self._wifi = (time.time(), None)
            if self._wifi[1] is not None: i['wifi'] = (self._wifi[1], 'signal, from the network manager')
        temps = [int(t) / 1000 for t in (read(z) for z in glob.glob('/sys/class/thermal/thermal_zone*/temp')) if t and t.lstrip('-').isdigit()]
        if temps: i['temp'] = max(temps)
        fans = [int(r) for r in (read(f) for f in glob.glob('/sys/class/hwmon/hwmon*/fan*_input') + glob.glob('/sys/devices/platform/applesmc.*/fan*_input')) if r and r.isdigit()]
        if fans: i['fan'] = max(fans)
        d = os.statvfs('/'); i['disk'] = (d.f_bavail * d.f_frsize, d.f_blocks * d.f_frsize)
        try: i['remote'] = sum(1 for n in os.listdir('/dev/pts') if n.isdigit())
        except OSError: pass
        return i

    def memory(self):
        m = {}
        with open('/proc/meminfo') as f:
            for line in f: k, v = line.split(':'); m[k] = int(v.split()[0]) * 1024
        total, free = m['MemTotal'], m['MemAvailable']
        agents = min(self.agent_mem, total - free)
        return total, free, agents, max(0, total - free - agents)


def gb(b): return f'{b / 2**30:.1f}'


def size(b): return f'{b / 2**30:.1f}G' if b >= 2**30 else f'{b / 2**20:.0f}M'


def uptime():
    with open('/proc/uptime') as f: s = float(f.read().split()[0])
    for n, unit in ((86400, 'day'), (3600, 'hour'), (60, 'minute')):
        if s >= n: k = int(s // n); return f'up {k} {unit}' + ('s' if k != 1 else '')
    return 'up a moment'


def area(cr, vals, x0, x1, base, top, fill, line=None):
    """A filled curve of vals (0..1) from x0 to x1, standing on base."""
    if len(vals) < 2: return
    step = (x1 - x0) / 39; start = x1 - step * (len(vals) - 1)
    pts = [(start + i * step, base - 6 - v * (base - 6 - top)) for i, v in enumerate(vals)]
    def trace():
        cr.move_to(*pts[0])
        for (ax, ay), (bx, by) in zip(pts, pts[1:]):
            mx = (ax + bx) / 2; cr.curve_to(mx, ay, mx, by, bx, by)
    trace(); cr.line_to(pts[-1][0], base); cr.line_to(pts[0][0], base); cr.close_path()
    cr.set_source_rgb(*rgb(fill)); cr.fill()
    if line: trace(); cr.set_source_rgb(*rgb(line)); cr.set_line_width(3); cr.stroke()


def zone(st, x, y, w, h, title, *lines):
    """Marks a place the pointer can rest on, and what to say there."""
    st.zones.append((x, y, w, h, title, lines))


def icon(cr, st, x, kind, title, *lines, level=None):
    """One round chip in the bar: a small drawing, and its words when the pointer rests on it."""
    cx, cy = x + 20, 38
    rect(cr, x, 18, 40, 40, GROUND, INK, 2.6, 20)
    cr.set_source_rgb(*rgb(INK)); cr.set_line_width(2.4); cr.set_line_cap(cairo.LINE_CAP_ROUND)
    if kind == 'battery':
        cr.rectangle(cx - 11, cy - 6, 20, 12); cr.stroke(); cr.rectangle(cx + 10, cy - 3, 2.5, 6); cr.fill()
        cr.set_source_rgb(*rgb(LEAF if (level or 0) > 0.25 else ACC)); cr.rectangle(cx - 8.5, cy - 3.5, 15 * max(0.08, level or 0), 7); cr.fill()
    elif kind == 'wifi':
        for k, r in enumerate((5, 10, 15)):
            cr.set_source_rgb(*rgb(INK if (level or 0) >= (k + 1) / 3 - 0.2 else DUSK))
            cr.arc(cx, cy + 8, r, -2.36, -0.78); cr.stroke()
        cr.set_source_rgb(*rgb(INK)); cr.arc(cx, cy + 8, 1.8, 0, 6.2832); cr.fill()
    elif kind == 'temp':
        cr.move_to(cx, cy - 10); cr.line_to(cx, cy + 3); cr.stroke(); cr.arc(cx, cy + 6, 5, 0, 6.2832); cr.fill()
        cr.set_line_width(5.5); cr.set_source_rgba(*rgb(INK), 0.25); cr.move_to(cx, cy - 10); cr.line_to(cx, cy + 3); cr.stroke()
    elif kind == 'disk':
        for dy in (-7, 0, 7):
            cr.save(); cr.translate(cx, cy + dy); cr.scale(1, 0.38); cr.arc(0, 0, 10, 0, 6.2832); cr.restore(); cr.stroke()
    elif kind == 'remote':
        cr.move_to(cx - 9, cy - 6); cr.line_to(cx - 2, cy); cr.line_to(cx - 9, cy + 6); cr.stroke()
        cr.move_to(cx + 1, cy + 7); cr.line_to(cx + 10, cy + 7); cr.stroke()
    elif kind == 'up':
        cr.arc(cx, cy, 10, 0, 6.2832); cr.stroke(); cr.move_to(cx, cy - 6); cr.line_to(cx, cy); cr.line_to(cx + 5, cy + 3); cr.stroke()
    cr.set_line_cap(cairo.LINE_CAP_BUTT)
    zone(st, x, 18, 40, 40, title, *lines)


def ipill(cr, x, w, kind, label, fill, level=0.0):
    """A bar pill with a small drawing at its left: agents (a face), load (a dial), memory (a chip)."""
    rect(cr, x, 18, w, 40, fill, INK, 2.6, 20)
    cx, cy = x + 22, 38
    cr.set_source_rgb(*rgb(INK)); cr.set_line_width(2.2); cr.set_line_cap(cairo.LINE_CAP_ROUND)
    if kind == 'agents':
        rect(cr, cx - 8, cy - 6, 16, 13, None, INK, 2.2, 4)
        cr.arc(cx - 3.2, cy, 1.5, 0, 6.2832); cr.fill(); cr.arc(cx + 3.2, cy, 1.5, 0, 6.2832); cr.fill()
        cr.move_to(cx, cy - 6); cr.line_to(cx, cy - 10); cr.stroke(); cr.arc(cx, cy - 11, 1.4, 0, 6.2832); cr.fill()
    elif kind == 'load':
        cr.arc(cx, cy + 5, 10, math.pi, 2 * math.pi); cr.stroke()
        a = math.pi * (1 + max(0.0, min(1.0, level)))
        cr.move_to(cx, cy + 5); cr.line_to(cx + 8 * math.cos(a), cy + 5 + 8 * math.sin(a)); cr.stroke()
        cr.arc(cx, cy + 5, 1.6, 0, 6.2832); cr.fill()
    elif kind == 'mem':
        cr.rectangle(cx - 6, cy - 6, 12, 12); cr.stroke(); cr.set_line_width(1.8)
        for d in (-3, 3):
            for ax, ay, bx, by in ((d, -6, d, -10), (d, 6, d, 10), (-6, d, -10, d), (6, d, 10, d)):
                cr.move_to(cx + ax, cy + ay); cr.line_to(cx + bx, cy + by); cr.stroke()
    cr.set_line_cap(cairo.LINE_CAP_BUTT)
    text(cr, x + 38 + (w - 38 - 12) / 2, 43, label, 13, INK, MONO, 600, 'middle', 0.6)


def tooltip(cr, st):
    """The words for the place under the pointer, on a slip of paper beside it."""
    if not st.mouse: return
    mx, my = st.mouse
    for x, y, w, h, title, lines in reversed(st.zones):
        if x <= mx <= x + w and y <= my <= y + h: break
    else: return
    lay = PangoCairo.create_layout(cr); fd = Pango.FontDescription(); fd.set_family(MONO); fd.set_absolute_size(15 * Pango.SCALE)
    lay.set_font_description(fd); widths = []
    for t in (title,) + tuple(lines): lay.set_text(t, -1); widths.append(lay.get_size()[0] / Pango.SCALE)
    bw = max(widths) + 44; bh = 40 + 22 * len(lines)
    bx = min(max(8, mx + 14), W - bw - 8); by = my + 22 if my + 22 + bh < H - 8 else my - bh - 12
    rect(cr, bx + 5, by + 5, bw, bh, INK); rect(cr, bx, by, bw, bh, SUN, INK, 3)
    text(cr, bx + 16, by + 26, title, 15, INK, MONO, 700)
    for k, t in enumerate(lines): text(cr, bx + 16, by + 49 + k * 22, t, 15, INK)


def draw(cr, st):
    st.zones = []
    total, free, agents, system = st.memory()
    # the bar: the name's pill and turtle are in the artwork
    wordmark(cr, 123, 45, 18, 'middle')
    pill(cr, 548, 18, 344, time.strftime('%a %d %b %Y · %H:%M:%S').upper(), GROUND, INK, 40, 15, INK, 1.6)
    i = st.info; ix = 212
    if 'battery' in i:
        pct, how = i['battery']; icon(cr, st, ix, 'battery', f'Battery {pct}%', how or 'state unknown', level=pct / 100); ix += 50
    if 'wifi' in i:
        q, how = i['wifi']; icon(cr, st, ix, 'wifi', f'Wi-Fi {q}%', how, level=q / 100); ix += 50
    if 'temp' in i:
        icon(cr, st, ix, 'temp', f"{i['temp']:.0f} °C", 'the warmest sensor', *([f"fan {i['fan']} turns a minute"] if 'fan' in i else [])); ix += 50
    df, dt = i.get('disk', (0, 1))
    icon(cr, st, ix, 'disk', f'{gb(df)} GB free on disk', f'of {gb(dt)} GB for Kimera'); ix += 50
    if 'remote' in i:
        r = i['remote']; icon(cr, st, ix, 'remote', f"{r} terminal{'' if r == 1 else 's'} open", 'here and from other machines'); ix += 50
    icon(cr, st, ix, 'up', uptime().replace('up ', 'Running for '), time.strftime('week %V, day %j of the year'))
    zone(st, 548, 18, 344, 40, time.strftime('%A %d %B %Y'), time.strftime('week %V · day %j of the year'))
    zone(st, 992, 18, 138, 40, f"{st.agents} agent{'' if st.agents == 1 else 's'} running", f'using {gb(agents)} GB of memory')
    zone(st, 1142, 18, 118, 40, f'Load {st.load * NCPU:.1f} of {NCPU}', f'{round(st.load * 100)}% of the processor', f'{NCPU} threads')
    zone(st, 1272, 18, 150, 40, f'{gb(total - free)} GB used of {gb(total)}', f'agents {gb(agents)} · system {gb(system)}', f'free {gb(free)} GB')
    n = st.agents
    ipill(cr, 992, 138, 'agents', f"{n} AGENT{'' if n == 1 else 'S'}", LEAF if n else GROUND)
    ipill(cr, 1142, 118, 'load', f'LOAD {st.load * NCPU:.1f}', GROUND, st.load)
    ipill(cr, 1272, 150, 'mem', f'MEM {gb(total - free)}/{gb(total)}', GROUND)

    # agents: what each is doing. Nothing reports yet, so it says so.
    panel(cr, 18, 76, 880, 304)
    text(cr, 42, 112, 'agents', 19, LEAF2, MONO, 600)
    pill(cr, 708, 92, 170, 'RUNNING' if n else 'NONE YET')
    cr.set_source_rgb(*rgb(LEAF)); cr.set_line_width(2); cr.move_to(42, 132); cr.line_to(874, 132); cr.stroke()
    if n:
        text(cr, 42, 200, f"{n} agent{'' if n == 1 else 's'} running", 32, SUN, SERIF, HEADW, spacing=1)
        text(cr, 42, 244, 'what each one is doing is not shown here yet', 17, LEAF2)
    else:
        text(cr, 42, 200, 'No agent is working', 32, SUN, SERIF, HEADW, spacing=1)
        text(cr, 42, 244, 'when one runs, its task and its last steps are listed here', 17, LEAF2)

    # the one that needs you: purple while quiet, paper when an agent asks
    panel(cr, 18, 394, 880, 296)
    text(cr, 44, 432, 'needs you', 19, LEAF2, MONO, 600)
    pill(cr, 686, 412, 190, 'NOTHING WAITS')
    text(cr, 44, 520, 'Nothing is waiting for an answer', 32, SUN, SERIF, HEADW, spacing=1)
    text(cr, 44, 564, 'a question from an agent turns this panel to paper', 17, LEAF2)

    # tasks: the processor over the last minute and a half, and the heaviest four
    panel(cr, 18, 704, 880, 178)
    pill(cr, 38, 722, 88, 'TASKS')
    text(cr, 142, 742, f'processor {round(st.load * 100)}%', 16, SUN, MONO, 500)
    area(cr, [a for a, _ in st.hist], 40, 440, 868, 768, LEAF)
    area(cr, [b for _, b in st.hist], 40, 440, 868, 768, DEEP)
    if len(st.hist) > 1:
        step = 400 / 39; start = 440 - step * (len(st.hist) - 1)

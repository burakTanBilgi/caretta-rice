def greetd(msg):
    """One question to greetd, the login manager, and its answer. Its own small protocol: a length, then JSON."""
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as c:
        c.connect(os.environ['GREETD_SOCK'])
        return greetd_on(c, msg)


def greetd_on(c, msg):
    raw = json.dumps(msg).encode(); c.sendall(struct.pack('=I', len(raw)) + raw)
    head = b''
    while len(head) < 4:
        part = c.recv(4 - len(head))
        if not part: return {'type': 'error', 'description': 'no answer'}
        head += part
    need = struct.unpack('=I', head)[0]; body = b''
    while len(body) < need:
        part = c.recv(need - len(body))
        if not part: break
        body += part
    return json.loads(body or b'{}')


def login(user, word, start):
    """Asks greetd to log user in with word and, when it agrees, to start the deck. True when it did."""
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as c:
            c.settimeout(30); c.connect(os.environ['GREETD_SOCK'])
            r = greetd_on(c, {'type': 'create_session', 'username': user})
            for _ in range(4):                     # it may ask more than once; every hidden question gets the word
                if r.get('type') != 'auth_message': break
                r = greetd_on(c, {'type': 'post_auth_message_response',
                                  'response': word if r.get('auth_message_type') == 'secret' else None})
            if r.get('type') == 'success':
                return greetd_on(c, {'type': 'start_session', 'cmd': start, 'env': []}).get('type') == 'success'
            greetd_on(c, {'type': 'cancel_session'})
    except (OSError, KeyError, ValueError): pass
    return False


def greeter():
    """The login screen. It runs before anyone is logged in, takes the password, and hands over to the deck."""
    gi.require_version('Gtk', '3.0'); gi.require_version('Gdk', '3.0')
    from gi.repository import Gtk, Gdk, GLib
    GLib.set_prgname('caretta-login')
    st = State(); cells, turtle = load_art(LOGIN_CELLS), load_art(LOGIN_TURTLE)
    win = Gtk.Window(title='caretta-login'); area_w = Gtk.DrawingArea(); win.add(area_w)

    def on_draw(_w, cr):
        a = area_w.get_allocation(); cr.scale(a.width / W, a.height / H); draw_login(cr, st, cells, turtle)

    def tick(): area_w.queue_draw(); return True

    def check(user, word):
        try: ok = login(user, word, ['/usr/local/bin/kimera-deck'])
        except Exception: ok = False               # any fault counts as a wrong password; the screen is never left stuck
        def done():
            st.checking = False; st.typed = st.user = ''; st.stage = 0
            if ok: Gtk.main_quit(); return False   # greetd starts the deck once this screen has gone
            st.wrong_n = len(word); st.wrong_u = len(user); st.wrong_until = time.time() + 0.7
            def shake(): area_w.queue_draw(); return st.wrong_until > time.time()
            GLib.timeout_add(30, shake); area_w.queue_draw(); return False
        GLib.idle_add(done)

    def on_key(_w, ev):
        name = Gdk.keyval_name(ev.keyval)
        if st.checking or st.wrong_until > time.time(): return True
        if take_key(st, name, Gdk.keyval_to_unicode(ev.keyval)):
            st.checking = True; threading.Thread(target=check, args=(st.user, st.typed), daemon=True).start()
        area_w.queue_draw(); return True

    area_w.connect('draw', on_draw); win.connect('key-press-event', on_key); win.connect('destroy', Gtk.main_quit)
    GLib.timeout_add_seconds(1, tick); win.show_all(); Gtk.main()


def window():
    gi.require_version('Gtk', '3.0'); gi.require_version('Gdk', '3.0')
    from gi.repository import Gtk, Gdk, GLib
    GLib.set_prgname('caretta-deck')
    st, art, rest_art = State(), load_art(), load_art(REST_ART)
    win = Gtk.Window(title='caretta-deck'); area_w = Gtk.DrawingArea(); win.add(area_w)

    def on_draw(_w, cr):
        a = area_w.get_allocation(); frame(cr, art, a.width, a.height, st, rest_art)

    beat = [0]

    def check(user, word):                         # off the drawing thread: the system waits a moment on a wrong word
        try: ok = password_ok(word)
        except Exception: ok = False               # any fault counts as a wrong password; the screen is never left stuck
        def done():
            st.checking = False; st.typed = st.user = ''; st.stage = 1
            if ok: st.locked = False; st.msg = 'unlocked'; st.last_key = time.time()
            else:                                  # shake for a moment, drawn quickly only while it lasts
                st.wrong_n = len(word); st.wrong_u = len(user); st.wrong_until = time.time() + 0.7
                def shake(): area_w.queue_draw(); return st.wrong_until > time.time()
                GLib.timeout_add(30, shake)
            area_w.queue_draw(); return False
        GLib.idle_add(done)

    def rest(on):                                  # resting dims the screen; it never turns it off
        st.resting = on; st.last_key = time.time()
        try: subprocess.Popen(['brightnessctl', '-q', '-s', 'set', '25%'] if on else ['brightnessctl', '-q', '-r'])
        except OSError: pass

    def tick():                                    # the clock moves every second; the machine is read every other one
        beat[0] += 1
        if beat[0] % 2 == 0: st.sample()
        if not st.resting and not st.locked and time.time() - st.last_key > REST_AFTER and st.off_until < time.time(): rest(True)
        area_w.queue_draw(); return True

    def on_key(_w, ev):
        k = Gdk.keyval_name(ev.keyval).lower()
        if st.locked:                              # every key belongs to the lock
            name = Gdk.keyval_name(ev.keyval)
            if st.checking or st.wrong_until > time.time(): return True    # not ready: keys are not taken
            if take_key(st, name, Gdk.keyval_to_unicode(ev.keyval)):
                st.checking = True; threading.Thread(target=check, args=(st.user, st.typed), daemon=True).start()
            st.stage = 1                           # the lock has the password row only
            area_w.queue_draw(); return True
        if st.resting: rest(False); st.msg = 'awake'; area_w.queue_draw(); return True     # any key wakes; it does nothing else
        st.last_key = time.time()
        if st.off_until > time.time():             # the question is open: only Y and N count
            if k == 'y':
                st.off_until = 0; st.msg = 'rebooting' if st.off_kind == 'reboot' else 'shutting down'
                subprocess.Popen(['/usr/local/bin/kimera-poweroff'] + (['reboot'] if st.off_kind == 'reboot' else []))
            elif k in ('n', 'escape'): st.off_until = 0; st.msg = 'staying on'
        elif k == 'o': st.off_kind = 'off'; st.off_until = time.time() + 15
        elif k == 'b': st.off_kind = 'reboot'; st.off_until = time.time() + 15
        elif k == 'd': os.execv(sys.executable, [sys.executable] + sys.argv)   # the deck starts afresh; nothing else stops
        elif k == 't': st.msg = 'a terminal'; subprocess.Popen(['foot', '--app-id=kimera-term', 'su', '-', pwd.getpwuid(os.getuid()).pw_name])   # asks the password
        elif k == 'l':
            if pam():
                subprocess.run(['swaymsg', '[app_id="kimera-term"] kill'], capture_output=True)    # no terminal stays over the lock
                st.locked = True; st.typed = st.user = ''; st.stage = 1; st.msg = 'locked'
            else: st.msg = 'cannot lock: no password check here'
        elif k == 'r': rest(True)
        elif k in ('y', 'n'): st.msg = 'no agent is asking'
        elif k in ('p', 's'): st.msg = 'no agent is running'
        else: return False
        area_w.queue_draw(); return True

    hover = [None]

    def on_move(_w, ev):                           # drawn again only when the pointer enters or leaves a place with words
        a = area_w.get_allocation(); mx, my = ev.x * W / a.width, ev.y * H / a.height
        hit = next((k for k in range(len(st.zones) - 1, -1, -1)
                    if st.zones[k][0] <= mx <= st.zones[k][0] + st.zones[k][2] and st.zones[k][1] <= my <= st.zones[k][1] + st.zones[k][3]), None)
        st.mouse = (mx, my)
        if hit != hover[0]: hover[0] = hit; area_w.queue_draw()

    def on_leave(_w, _ev): st.mouse = None; hover[0] = None; area_w.queue_draw()

    def on_scroll(_w, ev):                         # the wheel or two fingers, over the tasks, moves down the list
        if not st.mouse or not (18 <= st.mouse[0] <= 898 and 704 <= st.mouse[1] <= 882): return False
        ok, _dx, dy = ev.get_scroll_deltas()
        step = (1 if dy > 0 else -1) if ok and dy else {Gdk.ScrollDirection.DOWN: 1, Gdk.ScrollDirection.UP: -1}.get(ev.direction, 0)
        st.scroll = max(0, min(st.scroll + step, max(0, len(st.procs) - 4))); area_w.queue_draw(); return True

    area_w.add_events(Gdk.EventMask.POINTER_MOTION_MASK | Gdk.EventMask.LEAVE_NOTIFY_MASK | Gdk.EventMask.SCROLL_MASK | Gdk.EventMask.SMOOTH_SCROLL_MASK)
    area_w.connect('motion-notify-event', on_move); area_w.connect('leave-notify-event', on_leave); area_w.connect('scroll-event', on_scroll)
    area_w.connect('draw', on_draw); win.connect('key-press-event', on_key); win.connect('destroy', Gtk.main_quit)
    GLib.timeout_add_seconds(1, tick); win.show_all(); Gtk.main()


